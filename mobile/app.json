{
  "expo": {
    "name": "Savrdh Credit Resolution",
    "slug": "savrdh-credit-resolution",
    "version": "1.0.22",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "savrdhcredit",
    "owner": "savrdhtechnologys-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ea2f0a2c-3ad9-46f2-b3f7-6c03c97955f7",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "splash": {
      "backgroundColor": "#071426",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.savrdhfinancialservices.creditresolution",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely access your Savrdh account."
      }
    },
    "android": {
      "package": "com.savrdhfinancialservices.creditresolution",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "INTERNET"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker"
    ],
    "extra": {
      "websiteUrl": "https://savrdhfinancialservices.com",
      "clientPortalUrl": "https://savrdhfinancialservices.com/portal/login",
      "eas": {
        "projectId": "ea2f0a2c-3ad9-46f2-b3f7-6c03c97955f7"
      }
    }
  }
}
